<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:vm="using:PryamolineynostNew.ViewModels"
             x:Class="PryamolineynostNew.Views.LevelDataPageView"
             x:DataType="vm:LevelDataPageViewModel">
    <Design.DataContext>
        <vm:LevelDataPageViewModel />
    </Design.DataContext>
    
    <StackPanel Orientation="Vertical" Margin="10">
        <TextBlock Text="Данные уровня" 
                   FontSize="16" 
                   FontWeight="Bold" 
                   Margin="0,0,0,10" />

        <!-- Кнопка для добавления строки -->
        <StackPanel Orientation="Horizontal">
            
            <Button Content="+" Width="30" Height="30" 
                    VerticalContentAlignment="Center"
                    HorizontalContentAlignment="Center"
                    Margin="5,5,5,10"
                    Command="{Binding AddRowCommand}"/>
            
            <!-- Кнопка удаления строки -->
            <Button Content="-" Width="30" Height="30" 
                    VerticalContentAlignment="Center"
                    HorizontalContentAlignment="Center"
                    Command="{Binding DeleteRowCommand}"
                    Margin="5,5,5,10"/>
            
            <Border Margin="5,5,5,10"
                    BorderBrush="LightGray" 
                    BorderThickness="1"  />
            
            <!-- TODO Добавить функцию раскрытия ComboBox при нажатии на надпись -->
            <TextBlock Margin="5,5,5,10"
                       VerticalAlignment="Center"
                       Text="Единицы измерения:" />

            <ComboBox VerticalAlignment="Center" 
                      VerticalContentAlignment="Center" 
                      Width="150" 
                      Margin="5,5,5,10" 
                      ItemsSource="{Binding AvailableUnits}"
                      SelectedItem="{Binding SelectedItemText}" />


            <Border VerticalAlignment="Center"
                    Margin="5,5,5,10"
                    BorderBrush="LightGray" 
                    BorderThickness="1"/>
            
            <CheckBox Content="Обратный ход"
                      VerticalAlignment="Center"
                      VerticalContentAlignment="Center"
                      IsChecked="{Binding IsReverseStrokeSelect}"
                      Margin="5,5,5,10" />
            
            <CheckBox Content="Показать доп. поля" 
                      VerticalAlignment="Center"
                      VerticalContentAlignment="Center"
                      IsChecked="{Binding IsAdvancedFieldSelect}"
                      Margin="5,5,5,10" />

        </StackPanel>
        
        <DataGrid ItemsSource="{Binding LevelData}"
                  AutoGenerateColumns="False"
                  IsReadOnly="False"
                  GridLinesVisibility="All"
                  Margin="0,0,0,10"
				  >

            <DataGrid.Columns>
                <DataGridTextColumn Header="No" 
                                    Binding="{Binding PointNumber}" 
                                    IsReadOnly="True" 
                                    IsVisible="True"/>
                
                <DataGridTextColumn Header="Длина измерения, мм" 
                                    Binding="{Binding PointPosition}" 
                                    IsReadOnly="True" 
                                    IsVisible="True"/>
                
                <DataGridTextColumn Header="Фактический профиль проверяемой поверхности, мкм"
                                    Binding="{Binding ActualProfilePoint}" 
                                    IsReadOnly="True" 
                                    IsVisible="{Binding IsAdvancedFieldSelect}"/>
                
                <DataGridTextColumn Header="Прилягающая прямая, мкм" 
                                    Binding="{Binding AdjStraightPoint}"
                                    IsReadOnly="True" 
                                    IsVisible="{Binding IsAdvancedFieldSelect}"/>
                
                <DataGridTextColumn Header="Отклонение, мкм" 
                                    Binding="{Binding DeviationSize}" 
                                    IsReadOnly="True" 
                                    IsVisible="{Binding IsAdvancedFieldSelect}"/>
                
                <DataGridTextColumn Header="Отклонение на метре, мкм" 
                                    Binding="{Binding DeviationPerMeter}"
                                    IsReadOnly="True" 
                                    IsVisible="{Binding IsAdvancedFieldSelect}"/>
                
                <DataGridTextColumn Header="Среднее значение, мкм" 
                                    Binding="{Binding MeanPointValue}" 
                                    IsReadOnly="True" 
                                    IsVisible="{Binding IsReverseStrokeSelect}"/>

                <DataGridTextColumn Header="Прямой ход, мкм" 
                                    Binding="{Binding FwdPoint, Mode=TwoWay}" 
                                    IsVisible="{Binding IsMicrometrSelect}"/>
                
                <DataGridTextColumn Header="Обратный ход, мкм" 
                                    Binding="{Binding RevPoint, Mode=TwoWay}" 
                                    IsVisible="{Binding IsReverseMicrometrSelect}"/>

                <DataGridTextColumn Header="°, ПрХод" 
                                    Binding="{Binding FwdAngle, Mode=TwoWay}" 
                                    IsVisible="{Binding IsAngleSelect}"/>

                <DataGridTextColumn Header="', ПрХод" 
                                    Binding="{Binding FwdMinutes, Mode=TwoWay}" 
                                    IsVisible="{Binding IsAngleSelect}"/>
                
                <DataGridTextColumn Header="'', ПрХод"
                                    Binding="{Binding FwdSeconds, Mode=TwoWay}" 
                                    IsVisible="{Binding IsAngleSelect}"/>

                <DataGridTextColumn Header="°, ОбрХод" 
                                    Binding="{Binding RevAngle, Mode=TwoWay}" 
                                    IsVisible="{Binding IsReverseAngleSelect}"/>
                
                <DataGridTextColumn Header="', ОбрХод" 
                                    Binding="{Binding RevMinutes, Mode=TwoWay}" 
                                    IsVisible="{Binding IsReverseAngleSelect}"/>
                
                <DataGridTextColumn Header="'', ОбрХод" 
                                    Binding="{Binding RevSeconds, Mode=TwoWay}" 
                                    IsVisible="{Binding IsReverseAngleSelect}"/>
            </DataGrid.Columns>
        </DataGrid>


    </StackPanel>
</UserControl>