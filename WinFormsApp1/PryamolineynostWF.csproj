<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net8.0-windows7.0</TargetFramework>
        <Nullable>enable</Nullable>
        <UseWindowsForms>true</UseWindowsForms>
        <ImplicitUsings>enable</ImplicitUsings>
        <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
        <PlatformTarget>AnyCPU</PlatformTarget>
        <PackageReleaseNotes>Первая верисия.</PackageReleaseNotes>
        <Platforms>AnyCPU;x86</Platforms>
        <ApplicationIcon>Icon.ico</ApplicationIcon>
        <AssemblyVersion>1.2.7.1</AssemblyVersion>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
      <DebugType>embedded</DebugType>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x86'">
      <DebugType>embedded</DebugType>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
      <DebugType>embedded</DebugType>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x86'">
      <DebugType>embedded</DebugType>
    </PropertyGroup>

    <ItemGroup>
      <Content Include="Icon.ico" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.2.3" />
      <PackageReference Include="OxyPlot.Core" Version="2.2.0" />
      <PackageReference Include="OxyPlot.WindowsForms" Version="2.2.0" />
      <PackageReference Include="PDFsharp" Version="6.1.1" />
      <PackageReference Include="PDFsharp-MigraDoc" Version="6.1.1" />
      <PackageReference Include="Plotly.NET" Version="5.1.0" />
    </ItemGroup>

    <ItemGroup>
      <Compile Update="Views\Collimator\CollimatorCalibrationDateForm.cs">
        <SubType>Form</SubType>
      </Compile>
      <Compile Update="Views\Level\LevelDataForm.cs">
        <SubType>Form</SubType>
      </Compile>
      <Compile Update="Views\Level\ErrorForm.cs">
        <SubType>Form</SubType>
      </Compile>
      <Compile Update="Views\Level\LevelGraphicsForm.cs">
        <SubType>Form</SubType>
      </Compile>
      <Compile Update="Views\Level\LevelMainForm.cs">
        <SubType>Form</SubType>
      </Compile>
      <Compile Update="Views\DeviceChooseForm.cs">
        <SubType>Form</SubType>
      </Compile>
      <Compile Update="Views\Collimator\CollimatorForm.cs">
        <SubType>Form</SubType>
      </Compile>
      <Compile Update="Models\Collimator\MeasurementTable.cs">
        <SubType>Component</SubType>
      </Compile>
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Update="Controllers\Properties\Resources.resx">
        <Generator>ResXFileCodeGenerator</Generator>
        <LastGenOutput>Resources.Designer.cs</LastGenOutput>
      </EmbeddedResource>
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Controllers\Level\" />
    </ItemGroup>

</Project>